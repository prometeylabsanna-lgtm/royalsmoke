  "privacyTitle": "Patakaran sa privacy",
  "@privacyTitle": {
    "description": "M090"
  },
  "privacyBody1": "Ipinapaliwanag ng patakarang ito kung anong data ang pinoproseso ng RoyalSmoke app at bakit.",
  "@privacyBody1": {
    "description": "M091"
  },
  "privacyBody2": "Kapag nagpadala ka ng kahilingan, natatanggap namin ang mga detalyeng inilagay mo sa form (pangalan, contact, teksto ng kahilingan, gustong oras). Ginagamit lamang ang data na ito para makontak ka ng manager at masagot ang iyong kahilingan.",
  "@privacyBody2": {
    "description": "M092"
  },
  "privacyBody3": "Nag-iimbak din ang app ng mga setting sa iyong device (wika, kumpirmasyon ng edad) at maaaring magpadala ng mga teknikal na log para sa pag-diagnose ng aberya.",
  "@privacyBody3": {
    "description": "M093"
  },
  "privacyBody4": "Hindi kami gumagawa ng mga advertising profile at hindi nagbabahagi ng personal na data sa mga third party para sa marketing.",
  "@privacyBody4": {
    "description": "M094"
  },
  "privacyBody5": "Ang mga kahilingan para ma-access o mabura ang data ay maaaring ipadala sa “Contact”. Tumutugon kami sa makatwirang panahon alinsunod sa umiiral na batas ng Ukraine.",
  "@privacyBody5": {
    "description": "M095"
  },
  "termsTitle": "Mga tuntunin",
  "@termsTitle": {
    "description": "M096"
  },
  "termsBody1": "Sa paggamit ng RoyalSmoke app, kinukumpirma mong ikaw ay 21 taong gulang pataas at nabasa mo ang mga tuntuning ito.",
  "@termsBody1": {
    "description": "M097"
  },
  "termsBody2": "Pinapayagan ka ng app na magpadala ng kahilingan sa manager at hanapin ang mga contact. Sa pagpapadala ng kahilingan, sumasang-ayon ka na maaari kang kontakin ng manager gamit ang mga detalyeng ibinigay mo.",
  "@termsBody2": {
    "description": "M098"
  },
  "termsBody3": "Magbigay ng tamang contact details. Ang pagbibigay ng maling impormasyon, kabilang ang tungkol sa edad, ay maaaring magresulta sa paglimita ng access sa app.",
  "@termsBody3": {
    "description": "M099"
  },
  "termsBody4": "Maaari naming i-update ang mga teksto at istruktura ng mga seksyon. Ang patuloy na paggamit pagkatapos ng update ay nangangahulugang tinatanggap mo ang kasalukuyang bersyon ng mga tuntunin. Mga tanong — sa “Contact”.",
  "@termsBody4": {
    "description": "M100"
  },
  "termsBody5": "",
  "@termsBody5": {
    "description": "M101"
  },
  "agePolicyTitle": "Patakaran sa edad",
  "@agePolicyTitle": {
    "description": "M102"
  },
  "agePolicyBody1": "Ang RoyalSmoke app ay para sa mga user na 21 taong gulang pataas.",
  "@agePolicyBody1": {
    "description": "M103"
  },
  "agePolicyBody2": "Sa unang pagbukas, hihilingin ng app na kumpirmahin mo ang iyong edad. Kung walang kumpirmasyon, hindi magagamit ang mga pangunahing seksyon. Kung wala ka pang 21 taong gulang, mangyaring huwag gamitin ang app.",
  "@agePolicyBody2": {
    "description": "M104"
  },
  "agePolicyBody3": "Maaari naming i-update ang patakarang ito kung hinihingi ng mga pagbabago sa batas. Ang kasalukuyang bersyon ay laging nasa seksyong “Higit pa”.",
  "@agePolicyBody3": {
    "description": "M105"
  },
  "agePolicyBody4": "Sa paggamit ng app, kinukumpirma mo ang iyong edad at tinatanggap ang patakarang ito. Para sa mga tanong, gamitin ang “Contact”.",
  "@agePolicyBody4": {
    "description": "M106"
  },
