  "privacyTitle": "Kebijakan privasi",
  "@privacyTitle": {
    "description": "M090"
  },
  "privacyBody1": "Kebijakan ini menjelaskan data apa yang diproses aplikasi RoyalSmoke dan alasannya.",
  "@privacyBody1": {
    "description": "M091"
  },
  "privacyBody2": "Saat Anda mengirim permintaan, kami menerima data yang Anda isi di formulir (nama, kontak, isi permintaan, waktu yang diinginkan). Data ini hanya digunakan agar manajer dapat menghubungi Anda dan menanggapi permintaan Anda.",
  "@privacyBody2": {
    "description": "M092"
  },
  "privacyBody3": "Aplikasi juga menyimpan pengaturan di perangkat Anda (bahasa, konfirmasi usia) dan dapat mengirim log teknis untuk mendiagnosis gangguan.",
  "@privacyBody3": {
    "description": "M093"
  },
  "privacyBody4": "Kami tidak membuat profil iklan dan tidak membagikan data pribadi kepada pihak ketiga untuk pemasaran.",
  "@privacyBody4": {
    "description": "M094"
  },
  "privacyBody5": "Permintaan akses atau penghapusan data dapat dikirim melalui “Kontak”. Kami menanggapi dalam waktu yang wajar sesuai hukum Ukraina yang berlaku.",
  "@privacyBody5": {
    "description": "M095"
  },
  "termsTitle": "Ketentuan",
  "@termsTitle": {
    "description": "M096"
  },
  "termsBody1": "Dengan menggunakan aplikasi RoyalSmoke, Anda mengonfirmasi bahwa Anda berusia 21 tahun ke atas dan telah membaca ketentuan ini.",
  "@termsBody1": {
    "description": "M097"
  },
  "termsBody2": "Aplikasi memungkinkan Anda mengirim permintaan kepada manajer dan menemukan informasi kontak. Dengan mengirim permintaan, Anda setuju bahwa manajer dapat menghubungi Anda melalui data yang Anda berikan.",
  "@termsBody2": {
    "description": "M098"
  },
  "termsBody3": "Berikan data kontak yang benar. Memberikan informasi palsu, termasuk tentang usia, dapat mengakibatkan akses ke aplikasi dibatasi.",
  "@termsBody3": {
    "description": "M099"
  },
  "termsBody4": "Kami dapat memperbarui teks dan struktur bagian. Melanjutkan penggunaan setelah pembaruan berarti Anda menerima versi ketentuan yang berlaku. Pertanyaan — melalui “Kontak”.",
  "@termsBody4": {
    "description": "M100"
  },
  "termsBody5": "",
  "@termsBody5": {
    "description": "M101"
  },
  "agePolicyTitle": "Kebijakan usia",
  "@agePolicyTitle": {
    "description": "M102"
  },
  "agePolicyBody1": "Aplikasi RoyalSmoke tersedia untuk pengguna berusia 21 tahun ke atas.",
  "@agePolicyBody1": {
    "description": "M103"
  },
  "agePolicyBody2": "Saat pertama kali dibuka, aplikasi meminta Anda mengonfirmasi usia. Tanpa konfirmasi, bagian utama tidak dapat diakses. Jika Anda belum berusia 21 tahun, mohon jangan gunakan aplikasi ini.",
  "@agePolicyBody2": {
    "description": "M104"
  },
  "agePolicyBody3": "Kami dapat memperbarui rumusan kebijakan ini jika diwajibkan oleh perubahan peraturan. Versi terbaru selalu tersedia di bagian “Lainnya”.",
  "@agePolicyBody3": {
    "description": "M105"
  },
  "agePolicyBody4": "Dengan menggunakan aplikasi, Anda mengonfirmasi usia dan menerima kebijakan ini. Untuk pertanyaan, gunakan “Kontak”.",
  "@agePolicyBody4": {
    "description": "M106"
  },
