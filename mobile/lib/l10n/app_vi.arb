  "privacyTitle": "Chính sách bảo mật",
  "@privacyTitle": {
    "description": "M090"
  },
  "privacyBody1": "Chính sách này giải thích dữ liệu mà ứng dụng RoyalSmoke xử lý và lý do.",
  "@privacyBody1": {
    "description": "M091"
  },
  "privacyBody2": "Khi bạn gửi yêu cầu, chúng tôi nhận thông tin bạn nhập trong biểu mẫu (tên, thông tin liên hệ, nội dung yêu cầu, thời gian mong muốn). Dữ liệu này chỉ được dùng để quản lý liên hệ và phản hồi yêu cầu của bạn.",
  "@privacyBody2": {
    "description": "M092"
  },
  "privacyBody3": "Ứng dụng cũng lưu cài đặt trên thiết bị của bạn (ngôn ngữ, xác nhận độ tuổi) và có thể gửi nhật ký kỹ thuật để chẩn đoán lỗi.",
  "@privacyBody3": {
    "description": "M093"
  },
  "privacyBody4": "Chúng tôi không tạo hồ sơ quảng cáo và không chia sẻ dữ liệu cá nhân với bên thứ ba cho mục đích tiếp thị.",
  "@privacyBody4": {
    "description": "M094"
  },
  "privacyBody5": "Yêu cầu truy cập hoặc xóa dữ liệu có thể gửi qua “Liên hệ”. Chúng tôi phản hồi trong thời hạn hợp lý theo pháp luật hiện hành của Ukraina.",
  "@privacyBody5": {
    "description": "M095"
  },
  "termsTitle": "Điều khoản",
  "@termsTitle": {
    "description": "M096"
  },
  "termsBody1": "Khi sử dụng ứng dụng RoyalSmoke, bạn xác nhận rằng mình đã đủ 21 tuổi và đã đọc các điều khoản này.",
  "@termsBody1": {
    "description": "M097"
  },
  "termsBody2": "Ứng dụng cho phép bạn gửi yêu cầu cho quản lý và tìm thông tin liên hệ. Khi gửi yêu cầu, bạn đồng ý để quản lý liên hệ với bạn qua thông tin bạn đã cung cấp.",
  "@termsBody2": {
    "description": "M098"
  },
  "termsBody3": "Vui lòng cung cấp thông tin liên hệ chính xác. Việc cung cấp thông tin sai, kể cả về độ tuổi, có thể dẫn đến hạn chế quyền truy cập ứng dụng.",
  "@termsBody3": {
    "description": "M099"
  },
  "termsBody4": "Chúng tôi có thể cập nhật văn bản và cấu trúc các mục. Tiếp tục sử dụng sau khi cập nhật nghĩa là bạn chấp nhận phiên bản điều khoản hiện hành. Câu hỏi — qua “Liên hệ”.",
  "@termsBody4": {
    "description": "M100"
  },
  "termsBody5": "",
  "@termsBody5": {
    "description": "M101"
  },
  "agePolicyTitle": "Chính sách độ tuổi",
  "@agePolicyTitle": {
    "description": "M102"
  },
  "agePolicyBody1": "Ứng dụng RoyalSmoke dành cho người dùng từ 21 tuổi trở lên.",
  "@agePolicyBody1": {
    "description": "M103"
  },
  "agePolicyBody2": "Khi mở lần đầu, ứng dụng yêu cầu bạn xác nhận độ tuổi. Nếu không xác nhận, các mục chính sẽ không khả dụng. Nếu bạn chưa đủ 21 tuổi, vui lòng không sử dụng ứng dụng.",
  "@agePolicyBody2": {
    "description": "M104"
  },
  "agePolicyBody3": "Chúng tôi có thể cập nhật nội dung chính sách này nếu thay đổi pháp luật yêu cầu. Phiên bản hiện hành luôn có trong mục “Thêm”.",
  "@agePolicyBody3": {
    "description": "M105"
  },
  "agePolicyBody4": "Khi sử dụng ứng dụng, bạn xác nhận độ tuổi và chấp nhận chính sách này. Nếu có câu hỏi, hãy dùng “Liên hệ”.",
  "@agePolicyBody4": {
    "description": "M106"
  },
  "agePolicyBody5": "",
  "@agePolicyBody5": {
    "description": "M107"
  },
  "aboutTitle": "Về ứng dụng",
  "@aboutTitle": {
    "description": "M108"
  },
  "aboutBody1": "RoyalSmoke là ứng dụng dịch vụ cá nhân.",
  "@aboutBody1": {
    "description": "M109"
  },
  "aboutBody2": "Trong ứng dụng, bạn có thể gửi yêu cầu cho quản lý, xem xác nhận “Đã gửi yêu cầu” và tìm thông tin liên hệ: số điện thoại và giờ hỗ trợ.",
  "@aboutBody2": {
    "description": "M110"
  },
  "aboutBody3": "Giới hạn độ tuổi của ứng dụng là 21+.",
  "@aboutBody3": {
    "description": "M111"
  },
  "aboutBody4": "Để gửi yêu cầu, mở “Yêu cầu”. Để tìm hiểu cách dịch vụ hoạt động, mở “Dịch vụ”. Để liên hệ trực tiếp, mở “Liên hệ”.",
