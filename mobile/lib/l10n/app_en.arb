  "privacyTitle": "Privacy policy",
  "@privacyTitle": {
    "description": "M090"
  },
  "privacyBody1": "This policy explains what data the RoyalSmoke app processes and why.",
  "@privacyBody1": {
    "description": "M091"
  },
  "privacyBody2": "When you send a request, we receive the details you entered in the form (name, contact details, request text, preferred time). This data is used only so that a manager can contact you and respond to your request.",
  "@privacyBody2": {
    "description": "M092"
  },
  "privacyBody3": "The app also stores settings on your device (language, age confirmation) and may send technical logs to diagnose failures.",
  "@privacyBody3": {
    "description": "M093"
  },
  "privacyBody4": "We do not build advertising profiles and do not share personal data with third parties for marketing.",
  "@privacyBody4": {
    "description": "M094"
  },
  "privacyBody5": "Requests to access or delete your data can be sent via “Contacts”. We respond within a reasonable time in accordance with the applicable law of Ukraine.",
  "@privacyBody5": {
    "description": "M095"
  },
  "termsTitle": "Terms",
  "@termsTitle": {
    "description": "M096"
  },
  "termsBody1": "By using the RoyalSmoke app, you confirm that you are 21 or older and that you have read these terms.",
  "@termsBody1": {
    "description": "M097"
  },
  "termsBody2": "The app lets you send a request to a manager and find contact details. By sending a request, you agree that a manager may contact you using the details you provided.",
  "@termsBody2": {
    "description": "M098"
  },
  "termsBody3": "Please provide accurate contact details. Providing false information, including about your age, may result in restricted access to the app.",
  "@termsBody3": {
    "description": "M099"
  },
  "termsBody4": "We may update texts and section structure. Continuing to use the app after an update means you accept the current version of the terms. Questions — via “Contacts”.",
  "@termsBody4": {
    "description": "M100"
  },
  "termsBody5": "",
  "@termsBody5": {
    "description": "M101"
  },
  "agePolicyTitle": "Age policy",
  "@agePolicyTitle": {
    "description": "M102"
  },
  "agePolicyBody1": "The RoyalSmoke app is available to users aged 21 and over.",
  "@agePolicyBody1": {
    "description": "M103"
  },
  "agePolicyBody2": "On first launch the app asks you to confirm your age. Without confirmation the main sections are unavailable. If you are under 21, please do not use the app.",
  "@agePolicyBody2": {
    "description": "M104"
  },
  "agePolicyBody3": "We may update the wording of this policy if required by changes in legislation. The current version is always available under “More”.",
  "@agePolicyBody3": {
    "description": "M105"
  },
  "agePolicyBody4": "By using the app, you confirm your age and accept this policy. For questions, use “Contacts”.",
