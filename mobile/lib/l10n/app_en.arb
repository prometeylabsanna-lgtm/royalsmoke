  "privacyTitle": "Privacy policy",
  "@privacyTitle": {
    "description": "M090"
  },
  "privacyBody1": "This policy explains what data the Royal Smoke app may process and for what purpose.",
  "@privacyBody1": {
    "description": "M091"
  },
  "privacyBody2": "Royal Smoke is an informational guide to the lounge. We collect only the minimum technical data needed for the service to run reliably: for example, data saved locally on your device, basic session information, and technical logs for diagnosing failures.",
  "@privacyBody2": {
    "description": "M092"
  },
  "privacyBody3": "We do not build advertising profiles of users and do not share personal data with third parties for marketing.",
  "@privacyBody3": {
    "description": "M093"
  },
  "privacyBody4": "The guide's content is intended exclusively for adults (21+). Access is possible only after age confirmation. If you do not agree to these terms, stop using the app.",
  "@privacyBody4": {
    "description": "M094"
  },
  "privacyBody5": "Requests about data, access, or deletion of information on the device can be sent through the “Contacts” section. We respond within a reasonable time and within the requirements of current Ukrainian law.",
  "@privacyBody5": {
    "description": "M095"
  },
  "termsTitle": "Terms",
  "@termsTitle": {
    "description": "M096"
  },
  "termsBody1": "By using the Royal Smoke app, you confirm that you are 21 years old or older and that you have read these terms.",
  "@termsBody1": {
    "description": "M097"
  },
  "termsBody2": "The guide is provided for informational purposes: descriptions of partners, the history of the house, product lines, and contacts. The materials help you find your way around the world of our partners and the atmosphere of the space.",
  "@termsBody2": {
    "description": "M098"
  },
  "termsBody3": "Any decisions about visiting the house or reviewing the materials are yours alone, taking into account age restrictions and the rules of the venue.",
  "@termsBody3": {
    "description": "M099"
  },
  "termsBody4": "We may update the texts, images, and structure of sections without separate prior notice. Continuing to use the app after an update means you agree to the current version of the terms.",
  "@termsBody4": {
    "description": "M100"
  },
  "termsBody5": "For violating the rules of use or providing false information about your age, access to the guide may be restricted. For questions about the terms, use “Contacts”.",
  "@termsBody5": {
    "description": "M101"
  },
  "agePolicyTitle": "Age policy",
  "@agePolicyTitle": {
    "description": "M102"
  },
  "agePolicyBody1": "The content of the Royal Smoke guide is intended exclusively for people who are 21 or older.",
  "@agePolicyBody1": {
    "description": "M103"
  },
  "agePolicyBody2": "Before entering the main sections, the app asks you to confirm your age. This is a mandatory condition for accessing materials about the house and related content. If you are not yet 21, please leave the app.",
  "@agePolicyBody2": {
    "description": "M104"
  },
  "agePolicyBody3": "All pages are for reference and serve to introduce you to the house's partners and its space.",
  "@agePolicyBody3": {
    "description": "M105"
  },
  "agePolicyBody4": "We reserve the right to update the wording of the age policy if required by changes in legislation or the house's internal standards. The current version is always available in the “More” section.",
  "@agePolicyBody4": {
    "description": "M106"
  },
  "agePolicyBody5": "By using the app, you confirm your age and agree to this policy. For questions, use “Contacts”.",
  "@agePolicyBody5": {
    "description": "M107"
  },
  "aboutTitle": "About the app",
  "@aboutTitle": {
    "description": "M108"
  },
  "aboutBody1": "Royal Smoke is a lounge and a digital guide to its world.",
  "@aboutBody1": {
    "description": "M109"
  },
  "aboutBody2": "Here you will find the house's partners, short histories of the manufactories, the character of the lines, and the contacts of the space. The purpose of the app is to help you find your bearings calmly: who stands alongside the house, what sets each partner apart, and how to reach us.",
  "@aboutBody2": {
    "description": "M110"
  },
  "aboutBody3": "The guide is created for an adult audience of 21+ and covers the culture, origins, and atmosphere of the space we support.",
  "@aboutBody3": {
    "description": "M111"
  },
  "aboutBody4": "If you are looking for the address, opening hours, or directions, open “Contacts”. If you are interested in the partners, go to the “Lounge” section. And to understand the space of the house itself, take a look at “Lounge”.",
  "@aboutBody4": {
    "description": "M112"
  },
  "aboutBody5": "Thank you for choosing Royal Smoke as a place to get to know us.",
  "@aboutBody5": {
    "description": "M113"
  },
