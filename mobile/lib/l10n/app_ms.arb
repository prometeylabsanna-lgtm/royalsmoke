  "privacyTitle": "Dasar privasi",
  "@privacyTitle": {
    "description": "M090"
  },
  "privacyBody1": "Dasar ini menerangkan data yang diproses oleh aplikasi RoyalSmoke dan sebabnya.",
  "@privacyBody1": {
    "description": "M091"
  },
  "privacyBody2": "Apabila anda menghantar permintaan, kami menerima butiran yang anda masukkan dalam borang (nama, butiran hubungan, teks permintaan, masa pilihan). Data ini hanya digunakan supaya pengurus dapat menghubungi anda dan menjawab permintaan anda.",
  "@privacyBody2": {
    "description": "M092"
  },
  "privacyBody3": "Aplikasi juga menyimpan tetapan pada peranti anda (bahasa, pengesahan umur) dan mungkin menghantar log teknikal untuk mendiagnosis kerosakan.",
  "@privacyBody3": {
    "description": "M093"
  },
  "privacyBody4": "Kami tidak membina profil pengiklanan dan tidak berkongsi data peribadi dengan pihak ketiga untuk pemasaran.",
  "@privacyBody4": {
    "description": "M094"
  },
  "privacyBody5": "Permintaan untuk mengakses atau memadam data boleh dihantar melalui “Hubungi”. Kami menjawab dalam tempoh yang munasabah mengikut undang-undang Ukraine yang berkuat kuasa.",
  "@privacyBody5": {
    "description": "M095"
  },
  "termsTitle": "Terma",
  "@termsTitle": {
    "description": "M096"
  },
  "termsBody1": "Dengan menggunakan aplikasi RoyalSmoke, anda mengesahkan bahawa anda berumur 21 tahun ke atas dan telah membaca terma ini.",
  "@termsBody1": {
    "description": "M097"
  },
  "termsBody2": "Aplikasi ini membolehkan anda menghantar permintaan kepada pengurus dan mencari maklumat hubungan. Dengan menghantar permintaan, anda bersetuju bahawa pengurus boleh menghubungi anda menggunakan butiran yang diberikan.",
  "@termsBody2": {
    "description": "M098"
  },
  "termsBody3": "Sila berikan butiran hubungan yang tepat. Memberikan maklumat palsu, termasuk tentang umur, boleh menyebabkan akses ke aplikasi dihadkan.",
  "@termsBody3": {
    "description": "M099"
  },
  "termsBody4": "Kami boleh mengemas kini teks dan struktur bahagian. Terus menggunakan aplikasi selepas kemas kini bermakna anda menerima versi terma semasa. Pertanyaan — melalui “Hubungi”.",
  "@termsBody4": {
    "description": "M100"
  },
  "termsBody5": "",
  "@termsBody5": {
    "description": "M101"
  },
  "agePolicyTitle": "Dasar umur",
  "@agePolicyTitle": {
    "description": "M102"
  },
  "agePolicyBody1": "Aplikasi RoyalSmoke tersedia untuk pengguna berumur 21 tahun ke atas.",
  "@agePolicyBody1": {
    "description": "M103"
  },
  "agePolicyBody2": "Semasa pelancaran pertama, aplikasi meminta anda mengesahkan umur. Tanpa pengesahan, bahagian utama tidak boleh diakses. Jika anda belum berumur 21 tahun, sila jangan gunakan aplikasi ini.",
  "@agePolicyBody2": {
    "description": "M104"
  },
  "agePolicyBody3": "Kami boleh mengemas kini kata-kata dasar ini jika diperlukan oleh perubahan undang-undang. Versi terkini sentiasa tersedia di bahagian “Lagi”.",
  "@agePolicyBody3": {
    "description": "M105"
  },
  "agePolicyBody4": "Dengan menggunakan aplikasi, anda mengesahkan umur dan menerima dasar ini. Untuk pertanyaan, gunakan “Hubungi”.",
  "@agePolicyBody4": {
    "description": "M106"
  },
