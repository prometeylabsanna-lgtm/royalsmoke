[Unit]
Description=Royal Smoke Gunicorn
After=network.target postgresql.service

[Service]
User=royalsmoke
Group=royalsmoke
WorkingDirectory=/var/www/royalsmoke
EnvironmentFile=/etc/royalsmoke.env
ExecStart=/var/www/royalsmoke/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile - \
    config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
