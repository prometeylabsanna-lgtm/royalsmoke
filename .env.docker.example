# Copy to .env ON THE DROPLET only. Do not commit.
# Replace DROPLET_IP with the real IPv4. Leave no literal DROPLET_IP.

SECRET_KEY=generate-a-long-random-string
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings
ADMIN_URL=rs-admin

POSTGRES_DB=royalsmoke
POSTGRES_USER=royalsmoke
POSTGRES_PASSWORD=generate-a-strong-db-password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://royalsmoke:generate-a-strong-db-password@db:5432/royalsmoke

ALLOWED_HOSTS=DROPLET_IP,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=http://DROPLET_IP

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_NAME=rs_sessionid
CSRF_COOKIE_NAME=rs_csrftoken
SECURE_HSTS_SECONDS=0

LANGUAGE_CODE=uk
TIME_ZONE=Europe/Kyiv

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@royalsmoke.ua
NOTIFY_EMAIL=admin@royalsmoke.ua

TELEGRAM_BOT_TOKEN=

LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=1

NOVA_POSHTA_API_KEY=
NP_SENDER_CITY_REF=
NP_SENDER_WAREHOUSE_REF=
NP_SENDER_CONTACT=
NP_SENDER_PHONE=
NP_SENDER_REF=
NP_CONTACT_SENDER=
NP_SENDER_COUNTERPARTY_REF=
