# Django (локально). Прод-шаблон: .env.docker.example
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_URL=rs-admin
DATABASE_URL=postgres://user:password@localhost:5432/royalsmoke
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
LANGUAGE_CODE=uk
TIME_ZONE=Europe/Kyiv

# Email (Resend SMTP or any SMTP). Leave EMAIL_HOST empty for console backend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@royalsmoke.ua
NOTIFY_EMAIL=admin@royalsmoke.ua

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# LiqPay
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=1
# Test payment page (no real charge). Disable in production.
DEMO_PAYMENTS=1

# Nova Poshta
NOVA_POSHTA_API_KEY=
NP_SENDER_CITY_REF=
NP_SENDER_WAREHOUSE_REF=
NP_SENDER_CONTACT=
NP_SENDER_PHONE=
NP_SENDER_REF=
NP_CONTACT_SENDER=
NP_SENDER_COUNTERPARTY_REF=
